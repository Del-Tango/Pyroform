@startuml Pyroform_Directory_Structure
title Pyroform Project Structure and Imports

folder "pyroform/" {
  file "__init__.py" as Init
  file "pyroform.py" as MainLib
  file "cli.py" as CLI

  folder "src/" {
    file "__init__.py" as SrcInit
    file "pyroform_engine.py" as Engine
    file "models.py" as Models
    file "parser.py" as Parser
    file "sketch_generator.py" as SketchGen
    file "flow_engine.py" as FlowEngine
    file "validator.py" as Validator
    file "reporter.py" as Reporter
    file "scanner.py" as Scanner
    file "comparator.py" as Comparator
    file "splitter.py" as Splitter
    file "logging.py" as Logging
    file "config.py" as Config
  }
}

MainLib --> Engine : from .src.pyroform_engine import PyroformEngine
MainLib --> Models : from .src.models import ActionType, ValidationResult

CLI --> MainLib : from .pyroform import Pyroform
CLI --> Models : from .src.models import ActionType

Init --> MainLib : from .pyroform import Pyroform
Init --> CLI : from .cli import cli, execute_workflow
Init --> Models : from .src.models import PyroConfig, User, Group, Device, ActionType
Init --> Engine : from .src.pyroform_engine import PyroformEngine
Init --> Validator : from .src.validator import SystemValidator, ValidationResult

Engine --> Models : from .models import ActionType, PyroConfig
Engine --> Parser : from .parser import PyroParser
Engine --> SketchGen : from .sketch_generator import SketchGenerator
Engine --> FlowEngine : from .flow_engine import PyroflowEngine
Engine --> Validator : from .validator import SystemValidator, ValidationResult
Engine --> Reporter : from .reporter import ReportGenerator

Validator --> Scanner : from .scanner import SystemStateScanner
Validator --> Comparator : from .comparator import SystemStateComparator
Validator --> Models : from .models import PyroConfig, ValidationResult

SketchGen --> Models : from .models import PyroConfig, User, Group, Device, ActionType
SketchGen --> Splitter : from .splitter import ListSplitter
SketchGen --> Validator : from .validator import SystemValidator

@enduml
