@startuml
title Pyroform Class Dependencies

class Pyroform {
  - config: Dict
  - stdout: STDOUTMsg
  - engine: PyroformEngine
  + snapshot()
  + configure()
  + scorch()
  + mount()
  + validate()
  + execute_workflow()
}

class PyroformEngine {
  - parser: PyroParser
  - sketch_generator: SketchGenerator
  - flow_engine: PyroflowEngine
  - validator: SystemValidator
  - scanner: SystemStateScanner
  - reporter: ReportGenerator
  + snapshot()
  + configure()
  + scorch()
  + mount()
  + validate()
}

class PyroParser {
  + parse()
  - _parse_single_file()
  - _parse_directory()
}

class SketchGenerator {
  - command_generator: CommandGenerator
  - exclusion_checker: ExclusionChecker
  - state_parser: StateEntryParser
  + generate_sketch()
  + generate_snapshot_pyro_config()
  + generate_scorch_sketch()
}

class PyroflowEngine {
  - flow_engine: FlowEngine
  + execute_sketch()
  + pause_execution()
  + resume_execution()
}

class SystemValidator {
  - scanner: SystemStateScanner
  - comparator: SystemStateComparator
  + validate_configuration()
}

class SystemStateScanner {
  - exclusion_checker: ExclusionChecker
  + scan_system_state()
  - _scan_users()
  - _scan_groups()
  - _scan_mounted_devices()
}

class SystemStateComparator {
  + compare_states()
  - _compare_users()
  - _compare_groups()
  - _compare_filesystem()
}

class CommandGenerator {
  + generate_user_command()
  + generate_group_command()
  + generate_mount_command()
  + generate_cleanup_commands()
}

class ReportGenerator {
  + generate_action_report()
  + save_report()
}

class STDOUTMsg {
  + ok()
  + nok()
  + info()
  + warn()
  + err()
  + debug()
}

Pyroform --> PyroformEngine
PyroformEngine --> PyroParser
PyroformEngine --> SketchGenerator
PyroformEngine --> PyroflowEngine
PyroformEngine --> SystemValidator
PyroformEngine --> SystemStateScanner
PyroformEngine --> ReportGenerator

SketchGenerator --> CommandGenerator
SketchGenerator --> ExclusionChecker
SketchGenerator --> StateEntryParser

SystemValidator --> SystemStateScanner
SystemValidator --> SystemStateComparator

SystemStateScanner --> ExclusionChecker

@enduml
