@startuml Pyroform_All_Actions_Flow
title Pyroform All Actions - High-Level Flow Comparison

start
:User invokes CLI;

if (configure) then
    :Parse config files;
    :Generate user/group/device commands;
    :Execute FlowCTRL sketch;
    :Validate system state;
    :Generate configuration report;

elseif (validate)
    :Parse config files;
    :Scan current system state;
    :Compare with desired state;
    :Identify discrepancies;
    :Generate validation report;

elseif (mount)
    :Parse mount config;
    :Generate mount commands only;
    :Execute mount operations;
    :Verify mounts;
    :Generate mount report;

elseif (snapshot)
    :Scan entire system;
    :Capture users/groups/devices;
    :Build Pyro configuration;
    :Write to YAML file;
    :Generate snapshot report;

elseif (scorch)
    :Parse config files;
    :Identify extra resources;
    :Request user confirmation;
    :Generate cleanup commands;
    :Execute destructive removal;
    :Generate scorch report;

elseif (workflow)
    :Parse workflow config;
    :Execute steps sequentially;
    :Collect step results;
    :Generate combined report;
endif

:Return result to user;
stop

@enduml
