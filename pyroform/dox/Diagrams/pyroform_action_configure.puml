@startuml Pyroform_Configure_Sequence
title Pyroform Configure Action Sequence

actor User
participant CLI
participant Pyroform
participant PyroformEngine
participant PyroParser
participant SketchGenerator
participant CommandGenerator
participant PyroflowEngine
participant FlowCTRL
participant SystemValidator
participant Reporter

User -> CLI: pyroform configure -i config.yaml
CLI -> Pyroform: __init__(config)
Pyroform -> PyroformEngine: __init__(config)

CLI -> Pyroform: configure(input_path, dry_run=False, auto_confirm=False)
Pyroform -> PyroformEngine: configure(input_path, dry_run, auto_confirm)

group Parse Configuration Files
    PyroformEngine -> PyroParser: parse(input_path)
    PyroParser -> PyroParser: _parse_directory() or _parse_single_file()
    PyroParser -> PyroParser: _parse_single_file_data()
    PyroParser --> PyroformEngine: [PyroConfig, ...]
end

loop For each PyroConfig
    group Generate FlowCTRL Sketch
        PyroformEngine -> SketchGenerator: generate_sketch(config, ActionType.CONFIGURE)
        SketchGenerator -> CommandGenerator: generate_user_command()
        SketchGenerator -> CommandGenerator: generate_group_command()
        SketchGenerator -> CommandGenerator: generate_directory_command()
        SketchGenerator -> CommandGenerator: generate_permission_command()
        SketchGenerator --> PyroformEngine: sketch dict
    end

    group Execute Sketch
        PyroformEngine -> PyroflowEngine: execute_sketch(sketch, ActionType.CONFIGURE)
        PyroflowEngine -> PyroflowEngine: save sketch to temp file
        PyroflowEngine -> FlowCTRL: load_procedure(temp_file)
        PyroflowEngine -> FlowCTRL: purge_data()
        PyroflowEngine -> FlowCTRL: start_procedure()
        FlowCTRL --> PyroflowEngine: result
        PyroflowEngine --> PyroformEngine: success
    end

    group Validate Changes
        PyroformEngine -> SystemValidator: validate_configuration(config)
        SystemValidator -> SystemValidator: scan system state
        SystemValidator -> SystemValidator: compare with config
        SystemValidator --> PyroformEngine: ValidationResult
    end
end

group Generate Report
    PyroformEngine -> Reporter: generate_action_report()
    Reporter -> Reporter: _generate_summary()
    Reporter -> Reporter: _generate_details()
    Reporter --> PyroformEngine: report dict
end

PyroformEngine --> Pyroform: {success: bool, processed_configs: list, results: list}
Pyroform --> CLI: return result
CLI --> User: display success/failure with details

@enduml
