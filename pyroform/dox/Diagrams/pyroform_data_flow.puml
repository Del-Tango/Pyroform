@startuml
title Pyroform Data Flow

package "Input Sources" {
  [Pyro Config Files\n(JSON/YAML)]
  [CLI Parameters]
  [Config File]
  [Workflow File]
}

package "Processing" {
  [PyroParser]
  [PyroformEngine]
  [SketchGenerator]
  [CommandGenerator]
  [SystemStateScanner]
  [SystemStateComparator]
}

package "Output" {
  [FlowCTRL Sketch]
  [Reports\n(JSON/YAML)]
  [System Changes]
  [Validation Results]
}

package "External Systems" {
  [Linux System\n(Users/Groups/Files)]
  [FlowCTRL Engine]
}

[Pyro Config Files] --> [PyroParser] : parse
[CLI Parameters] --> [PyroformEngine] : configuration
[Config File] --> [PyroformEngine] : settings
[Workflow File] --> [Pyroform] : workflow steps

[PyroParser] --> [PyroformEngine] : PyroConfig objects
[PyroformEngine] --> [SketchGenerator] : config + action
[SketchGenerator] --> [CommandGenerator] : entity details
[CommandGenerator] --> [SketchGenerator] : command objects

[PyroformEngine] --> [SystemStateScanner] : scan request
[Linux System] --> [SystemStateScanner] : system state
[SystemStateScanner] --> [PyroformEngine] : current state

[PyroformEngine] --> [SystemStateComparator] : compare states
[SystemStateComparator] --> [PyroformEngine] : differences

[SketchGenerator] --> [PyroflowEngine] : FlowCTRL sketch
[PyroflowEngine] --> [FlowCTRL Engine] : execute sketch
[FlowCTRL Engine] --> [Linux System] : apply changes

[PyroformEngine] --> [ReportGenerator] : results + metadata
[ReportGenerator] --> [Reports] : save reports

[PyroformEngine] --> [Validation Results] : display/output
@enduml
